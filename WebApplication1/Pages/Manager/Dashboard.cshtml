@page "/Manager/Dashboard"
@model Api.Pages.Manager.DashboardModel

<h2>Manager Dashboard</h2>

<div class="actions">

    <form method="get" asp-page-handler="All">
        <input type="hidden" name="handler" value="All" />
        <button type="submit">Pobierz wszystkich</button>
    </form>

    <form method="get" asp-page-handler="Deleted">
        <input type="hidden" name="handler" value="Deleted" />
        <button type="submit">Pobierz usuniętych</button>
    </form>
</div>

<!-- Active Employees -->
@if (Model.ActiveEmployees is not null)
{
    <div class="card">
        <h3>Aktywni pracownicy</h3>
        <ul>
            @foreach (var emp in Model.ActiveEmployees)
            {
                <li>
                    <span class="emp-info">@emp.EmployeeId - @emp.Username</span>
                </li>
            }
        </ul>

        <!-- PAGINATION -->
        <div class="pagination-container">

            <div class="pagination-info">
                <p>Page @Model.PageNumber of @Model.TotalPages</p>
                <p>Total records: @Model.TotalRecords</p>
            </div>

            <div class="pagination-controls">
                @if (Model.HasPreviousPage)
                {
                    <a asp-page="/Manager/Dashboard"
                       asp-page-handler="All"
                       asp-route-pageNumber="@(Model.PageNumber - 1)"
                       asp-route-pageSize="@Model.PageSize"
                       class="page-btn">Previous</a>
                }

                @if (Model.HasNextPage)
                {
                    <a asp-page="/Manager/Dashboard"
                       asp-page-handler="All"
                       asp-route-pageNumber="@(Model.PageNumber + 1)"
                       asp-route-pageSize="@Model.PageSize"
                       class="page-btn">Next</a>
                }
            </div>

            <form method="get">
                <input type="hidden" name="handler" value="All" />
                <input type="hidden" name="pageNumber" value="@Model.PageNumber" />

                <label>Page size:</label>
                <select name="pageSize" onchange="this.form.submit()">
                    <option value="5" selected="@(Model.PageSize == 5)">5</option>
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="20" selected="@(Model.PageSize == 20)">20</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50</option>
                </select>
            </form>

            <form method="get">
                <input type="hidden" name="handler" value="All" />
                <input type="hidden" name="pageSize" value="@Model.PageSize" />

                <label>Go to page:</label>
                <input type="number" name="pageNumber" min="1" max="@Model.TotalPages" value="@Model.PageNumber" />

                <button type="submit" class="page-btn">Go</button>
            </form>

        </div>
    </div>
}

<!-- Deleted Employees -->
@if (Model.DeletedEmployees is not null)
{
    <div class="card">
        <h3>Usunięci pracownicy</h3>
        <ul>
            @foreach (var emp in Model.DeletedEmployees)
            {
                <li>
                    <span class="emp-info">@emp.EmployeeId - @emp.Username</span>

                    <div class="emp-actions">

                        <!-- Restore -->
                        <form method="post" asp-page-handler="Restore">
                            <input type="hidden" name="employeeId" value="@emp.EmployeeId" />
                            <button type="submit">Przywróć</button>
                        </form>

                        <!-- Update -->
                        <form method="post" asp-page-handler="Update">
                            <input type="hidden" name="employeeId" value="@emp.EmployeeId" />

                            <label>Username:</label>
                            <input type="text" name="Username" value="@emp.Username" />

                            <label>Email:</label>
                            <input type="email" name="Email" value="@emp.Email" />

                            <label>Salary:</label>
                            <input type="number" name="Salary" value="@emp.Salary" />

                            <button type="submit">Zaktualizuj</button>
                        </form>
                    </div>
                </li>
            }
        </ul>
    </div>
}

@if (Model.RestoredEmployee is not null)
{
    <div class="msg success">
        Przywrócono: @Model.RestoredEmployee.Username
    </div>
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="msg error">
        @Model.Error
    </div>
}

<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f5f7fa;
        margin: 0;
        padding: 20px;
    }

    h2 {
        margin-bottom: 20px;
        font-size: 28px;
        font-weight: 600;
        color: #333;
    }

    .actions {
        display: flex;
        gap: 12px;
        margin-bottom: 25px;
    }

    button {
        background: #4a6cf7;
        border: none;
        padding: 10px 18px;
        color: white;
        border-radius: 6px;
        cursor: pointer;
        font-size: 14px;
        transition: 0.2s;
    }

        button:hover {
            background: #3a56c9;
        }

    .card {
        background: white;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        margin-bottom: 25px;
    }

        .card h3 {
            margin-top: 0;
            margin-bottom: 15px;
            font-size: 20px;
            color: #444;
        }

    ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    li {
        background: #f0f2f7;
        padding: 10px 14px;
        border-radius: 6px;
        margin-bottom: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .emp-info {
        font-weight: 500;
        color: #333;
    }

    .emp-actions {
        display: flex;
        gap: 10px;
        align-items: center;
    }

        .emp-actions form {
            display: flex;
            gap: 8px;
            align-items: center;
        }

    input[type="text"],
    input[type="email"],
    input[type="number"] {
        padding: 6px 8px;
        border: 1px solid #ccc;
        border-radius: 5px;
        font-size: 13px;
        width: 140px;
    }

    label {
        font-size: 12px;
        color: #555;
    }

    .msg {
        padding: 12px;
        border-radius: 6px;
        margin-top: 15px;
        font-weight: 500;
    }

        .msg.success {
            background: #e6f7e6;
            color: #2e7d32;
        }

        .msg.error {
            background: #fdecea;
            color: #c62828;
        }

    /* PAGINATION */
    .pagination-container {
        background: #ffffff;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        margin-top: 20px;
    }

    .pagination-info p {
        margin: 4px 0;
        color: #444;
        font-size: 14px;
    }

    .pagination-controls {
        margin: 15px 0;
    }

    .page-btn {
        background: #4a6cf7;
        padding: 8px 14px;
        border-radius: 6px;
        color: white;
        text-decoration: none;
        margin-right: 10px;
        font-size: 14px;
        transition: 0.2s;
    }

        .page-btn:hover {
            background: #3a56c9;
        }

    .pagination-size,
    .pagination-jump {
        margin-top: 12px;
    }

        .pagination-size select,
        .pagination-jump input[type="number"] {
            padding: 6px 8px;
            border-radius: 6px;
            border: 1px solid #ccc;
            margin-left: 8px;
        }

        .pagination-jump button {
            margin-left: 10px;
        }
</style>
