@page "{id:int}"
@model Api.Pages.Employees.EmployeeInfoModel

<h2>User</h2>

@if (Model.User is null)
{
    <p>User not found.</p>
}
else
{
    <p><strong>ID:</strong> @Model.Employee.EmployeeId</p>
    <p><strong>Username:</strong> @Model.Employee.Username</p>
}

<hr />

<h2>User Info</h2>

@if (Model.EmployeeInfo is null)
{
    <p>No additional info.</p>
}
else
{
    <p><strong>Department:</strong> @Model.EmployeeInfo.Department</p>
    <p><strong>Position:</strong> @Model.EmployeeInfo.Position</p>
    <p><strong>Colleague:</strong> @Model.EmployeeInfo.Collegue</p>
}
